# DB shared
POSTGRES_HOST=database
POSTGRES_PORT=5432
POSTGRES_SYNCHRONIZE=true
PGDATA=/var/lib/postgresql/data

# DB personal
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=db

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=14d

# Application
PORT=3000